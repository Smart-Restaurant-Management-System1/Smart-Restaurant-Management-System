# ============================================
# Cinnamon Bistro - Environment Configuration
# ============================================

# Frontend API URLs
VITE_IDENTITY_API_URL=http://localhost:5001
VITE_RESERVATION_API_URL=http://localhost:5000
VITE_ORDER_API_URL=http://localhost:5003
VITE_BILLING_API_URL=http://localhost:5004
VITE_REPORT_API_URL=http://localhost:5005


# Azure MySQL Database
DB_HOST=mysql-cinnamon-bistro-dev.mysql.database.azure.com
DB_PORT=3306
DB_NAME=cinnamon_bistro
DB_USER=cinnamonadmin
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_SSL_MODE=Required
# Local Docker Compose
MYSQL_ROOT_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
MYSQL_HOST_PORT=3307
IDENTITY_DB_NAME=restaurant_identity_db
RESERVATION_DB_NAME=restaurant_reservation_db

JWT_KEY=YOUR_DEVELOPMENT_JWT_KEY
JWT_ISSUER=SmartRestaurant
JWT_AUDIENCE=SmartRestaurantUsers
STAFF_AUTHORIZATION_CODE=YOUR_STAFF_AUTHORIZATION_CODE

# PayHere Sandbox Credentials & URLs
PAYHERE_MERCHANT_ID=1238640
PAYHERE_MERCHANT_SECRET=YOUR_PAYHERE_MERCHANT_SECRET
PAYHERE_AZURE_MERCHANT_SECRET=YOUR_PAYHERE_AZURE_MERCHANT_SECRET
PAYHERE_LOCAL_MERCHANT_SECRET=YOUR_PAYHERE_LOCAL_MERCHANT_SECRET
PAYHERE_AZURE_NOTIFY_URL=https://frontend-web.purpledesert-2900c071.eastasia.azurecontainerapps.io/reservation-api/api/payments/payhere/notify
PAYHERE_AZURE_RETURN_URL=https://frontend-web.purpledesert-2900c071.eastasia.azurecontainerapps.io/orders/track?payment=returned
PAYHERE_AZURE_CANCEL_URL=https://frontend-web.purpledesert-2900c071.eastasia.azurecontainerapps.io/orders/track?payment=cancelled
